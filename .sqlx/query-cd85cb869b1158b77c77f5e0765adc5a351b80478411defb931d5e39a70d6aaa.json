  "query": "\n                SELECT\n                    id,\n                    language,\n                    definition,\n                    span_content,\n                    created_at,\n                    updated_at,\n                    created_by,\n                    updated_by\n                FROM quotation_suggestion\n                WHERE definition = $1\n                ORDER BY created_at DESC\n                LIMIT $2\n                OFFSET $3\n            ",
