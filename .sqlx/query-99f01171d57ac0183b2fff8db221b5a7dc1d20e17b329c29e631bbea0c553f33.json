  "query": "\n            update phonology_tables\n            set name = COALESCE($1, name),\n                description = COALESCE($2, description),\n                body = COALESCE($3, body),\n                schema_version = CASE WHEN $3 IS NOT NULL THEN schema_version + 1 ELSE schema_version END,\n                updated_at = now()\n            where id = $4\n            returning *\n            ",
