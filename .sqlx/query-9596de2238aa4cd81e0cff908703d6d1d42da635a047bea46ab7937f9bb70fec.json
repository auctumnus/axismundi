  "db_name": "PostgreSQL",
  "query": "\n            UPDATE users\n            SET username = COALESCE($2, username),\n                display_name = $3,\n                description = $4,\n                pronouns = $5,\n                gender = $6,\n                updated_at = CURRENT_TIMESTAMP,\n                password_hash = $7\n            WHERE id = $1\n            RETURNING users.*, (SELECT slug FROM bookmarks WHERE item = users.id AND resource = 'user') as \"bookmark!\"\n            ",
