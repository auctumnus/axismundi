  "query": "\n                SELECT\n                    id,\n                    slug,\n                    title,\n                    content,\n                    published_at,\n                    created_at,\n                    updated_at,\n                    created_by,\n                    updated_by\n                FROM news\n                WHERE published_at IS NOT NULL\n                ORDER BY published_at DESC, id DESC\n                LIMIT $1\n            ",
