  "query": "\n                SELECT\n                    id,\n                    word,\n                    definition,\n                    context,\n                    created_at,\n                    updated_at,\n                    created_by,\n                    updated_by\n                FROM definitions\n                WHERE word = $1\n                ORDER BY created_at DESC\n                LIMIT $2\n                OFFSET $3\n            ",
