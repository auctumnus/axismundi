  "query": "\n                UPDATE quotation\n                SET span_start = COALESCE($2, span_start),\n                    span_end = COALESCE($3, span_end),\n                    updated_by = $4,\n                    updated_at = CURRENT_TIMESTAMP\n                WHERE id = $1\n                RETURNING id, translation, definition, span_start, span_end, created_at, updated_at, created_by, updated_by\n            ",
