  "query": "\n                UPDATE definitions\n                SET definition = COALESCE($2, definition),\n                    context = COALESCE($3, context),\n                    updated_by = $4,\n                    updated_at = CURRENT_TIMESTAMP\n                WHERE id = $1\n                RETURNING id, word, definition, context, created_at, updated_at, created_by, updated_by\n            ",
