  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                    id,\n                    slug,\n                    title,\n                    english,\n                    source_name,\n                    source_url,\n                    source_content,\n                    source_language,\n                    created_at,\n                    updated_at,\n                    created_by,\n                    updated_by,\n                    like_count,\n                    description,\n                    published_at,\n                    (\n                        SELECT COUNT(*)\n                        FROM translation\n                        WHERE translation.translatable = translatable.id\n                    ) AS \"translations_count!\"\n                FROM translatable\n                WHERE slug = $1\n            ",
