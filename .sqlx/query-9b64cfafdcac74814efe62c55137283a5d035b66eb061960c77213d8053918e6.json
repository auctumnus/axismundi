  "query": "\n                UPDATE quotation_suggestion\n                SET span_content = COALESCE($2, span_content),\n                    updated_by = $3,\n                    updated_at = CURRENT_TIMESTAMP\n                WHERE id = $1\n                RETURNING id, language, definition, span_content, created_at, updated_at, created_by, updated_by\n            ",
