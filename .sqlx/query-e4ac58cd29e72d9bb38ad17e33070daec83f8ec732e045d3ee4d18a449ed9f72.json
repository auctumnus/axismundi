  "query": "\n                SELECT\n                    id,\n                    translation,\n                    definition,\n                    span_start,\n                    span_end,\n                    created_at,\n                    updated_at,\n                    created_by,\n                    updated_by\n                FROM quotation\n                WHERE translation = $1\n                ORDER BY span_start ASC\n                LIMIT $2\n                OFFSET $3\n            ",
