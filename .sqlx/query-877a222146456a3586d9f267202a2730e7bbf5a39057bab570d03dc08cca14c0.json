  "query": "\n                UPDATE news\n                SET slug = COALESCE($2, slug),\n                    title = COALESCE($3, title),\n                    content = COALESCE($4, content),\n                    updated_by = $5,\n                    updated_at = CURRENT_TIMESTAMP\n                WHERE id = $1\n                RETURNING id, slug, title, content, published_at, created_at, updated_at, created_by, updated_by\n            ",
