{
  "db_name": "PostgreSQL",
  "query": "\n                select\n                    users.id,\n                    users.username,\n                    users.email,\n                    users.password_hash,\n                    users.display_name,\n                    users.description,\n                    users.pronouns,\n                    users.gender,\n                    users.profile_picture_object_id,\n                    users.banner_object_id,\n                    users.tags,\n                    users.created_at,\n                    users.updated_at,\n                    users.verified_at,\n                    COALESCE(b.slug, '')::text as \"bookmark!\"\n                from users\n                left join bookmarks b on b.item = users.id and b.resource = 'user'\n                where users.id = $1\n                ",
