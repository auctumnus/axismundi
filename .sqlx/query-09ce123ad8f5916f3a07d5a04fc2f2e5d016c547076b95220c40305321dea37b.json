{
  "db_name": "PostgreSQL",
  "query": "\n            select count(*)\n            from audit_logs\n            where\n                ($1::uuid is null or user_id = $1)\n                and ($2::audit_action_type is null or action = $2)\n                and ($3::auditable_resource is null or resource_type = $3)\n                and ($4::uuid is null or resource_id = $4)\n            ",
  "describe": {
    "columns": [
      {
        "ordinal": 0,
        "name": "count",
        "type_info": "Int8"
      }
    ],
    "parameters": {
      "Left": [
        "Uuid",
        {
          "Custom": {
            "name": "audit_action_type",
            "kind": {
              "Enum": [
                "created",
                "updated",
                "deleted",
                "updated_report",
                "user_ban",
                "user_unban",
                "add_tag",
                "remove_tag"
              ]
            }
          }
        },
        {
          "Custom": {
            "name": "auditable_resource",
