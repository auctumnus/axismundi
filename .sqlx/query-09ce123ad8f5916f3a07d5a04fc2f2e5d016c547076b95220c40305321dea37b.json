                "report",
                "language_family_res",
                "language_family",
                "language_family_member",
                "language_family_invite",
                "language_family_permission",
                "word_category"
              ]
            }
          }
        },
        "Uuid"
      ]
    },
    "nullable": [
      null
    ]
  },
