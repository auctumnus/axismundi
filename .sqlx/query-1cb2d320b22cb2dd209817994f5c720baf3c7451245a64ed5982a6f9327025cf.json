{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT users.*,\n                    COALESCE(bookmarks.slug, '')::text as \"bookmark!\"\n                FROM users\n                JOIN words ON words.created_by = users.id\n                LEFT JOIN bookmarks ON bookmarks.item = users.id AND bookmarks.resource = 'user'\n                WHERE words.id = $1\n            ",
