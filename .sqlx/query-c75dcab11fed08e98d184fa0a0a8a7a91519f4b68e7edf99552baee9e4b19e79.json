{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                    users.id,\n                    users.username,\n                    users.email,\n                    users.password_hash,\n                    users.display_name,\n                    users.description,\n                    users.pronouns,\n                    users.gender,\n                    users.profile_picture_object_id,\n                    users.banner_object_id,\n                    users.verified_at,\n                    users.tags,\n                    users.created_at,\n                    users.updated_at,\n                    COALESCE(bookmarks.slug, '')::text as \"bookmark!\"\n                FROM users\n                LEFT JOIN bookmarks ON bookmarks.item = users.id AND bookmarks.resource = 'user'\n                ORDER BY users.created_at DESC\n                LIMIT $1\n                OFFSET $2\n            ",
