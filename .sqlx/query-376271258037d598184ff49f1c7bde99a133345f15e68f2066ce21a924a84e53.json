  "query": "\n                select id, user_id, reason, banned_at, banned_by\n                from user_bans\n                where\n                    ($1::TEXT IS NULL OR reason ILIKE '%' || $1 || '%')\n                    and ($2::UUID IS NULL OR banned_by = $2)\n                order by banned_at desc\n                limit $3\n                offset $4\n            ",
