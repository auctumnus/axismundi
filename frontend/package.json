{
  "name": "frontend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build.ts",
    "build:annotation": "parcel build",
    "dev": "bun build.ts -- --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "typecheck": "tsc"
  },
  "targets": {
    "annotation": {
      "source": "./src/annotation.tsx",
      "distDir": "./dist",
      "optimize": true
    },
    "text-editor": {
      "source": "./src/text-editor.tsx",
      "distDir": "./dist",
      "optimize": true
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/is-hotkey": "^0.1.10",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "parcel": "^2.13.3"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.4",
    "@iconify-json/material-symbols": "^1.2.48",
    "@iconify/react": "^6.0.2",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.13.3",
    "date-fns": "^4.1.0",
    "is-hotkey": "^0.2.0",
    "lightningcss": "^1.30.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-select": "^5.10.2",
    "slate": "^0.118.1",
    "slate-history": "^0.113.1",
    "slate-react": "^0.119.0"
  }
}