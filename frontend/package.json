{
  "name": "frontend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build.ts",
    "build:annotation": "parcel build",
    "build:lexurgy-grammar": "lezer-generator ./lexurgy.grammar -o src/lexurgy-parser.js",
    "dev": "bun build.ts -- --watch",
    "format": "prettier --write src/**/*.ts src/**/*.tsx src/**/*.css",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "typecheck": "tsc"
  },
  "targets": {
    "annotation": {
      "source": "./src/annotation.tsx",
      "distDir": "./dist",
      "optimize": true
    },
    "text-editor": {
      "source": "./src/text-editor.tsx",
      "distDir": "./dist",
      "optimize": true
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/is-hotkey": "^0.1.10",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "parcel": "^2.13.3",
    "prettier": "^3.8.1"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@lezer/common": "^1.5.1",
    "@lezer/lr": "^1.4.8"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.40.0",
    "@floating-ui/dom": "^1.7.4",
    "@floating-ui/react": "^0.27.19",
    "@headlessui/react": "^2.2.9",
    "@iconify-json/material-symbols": "^1.2.48",
    "@iconify/react": "^6.0.2",
    "@lezer/common": "^1.5.1",
    "@lezer/generator": "^1.8.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.8",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.13.3",
    "date-fns": "^4.1.0",
    "is-hotkey": "^0.2.0",
    "lightningcss": "^1.30.1",
    "motion": "^12.38.0",
    "panzoom": "^9.4.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-select": "^5.10.2",
    "slate": "^0.118.1",
    "slate-history": "^0.113.1",
    "slate-react": "^0.119.0"
  }
}